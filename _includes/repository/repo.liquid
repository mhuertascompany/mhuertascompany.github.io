<div class="repo col-md-6 p-2">
  <div class="card h-100 p-3">
    <h3 class="h5 text-break">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
      <a href="https://github.com/{{ include.repository }}">{{ include.repository }}</a>
    </h3>
    {% assign description = site.data.repositories.descriptions[include.repository] %}
    {% if description %}<p class="mb-0">{{ description }}</p>{% endif %}
  </div>
</div>
